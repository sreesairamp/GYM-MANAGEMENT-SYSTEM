<?php
// Database connection
$servername = "localhost";
$username = "root";
$password = "";
$dbname = "gym_db";

// Create connection
$conn = new mysqli($servername, $username, $password, $dbname);

// Check connection
if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

// Handle form submissions
if ($_SERVER["REQUEST_METHOD"] == "POST") {
    // Add new member
    if (isset($_POST['add_member'])) {
        $name = $_POST['name'];
        $email = $_POST['email'];
        $phone = $_POST['phone'];
        $gender = $_POST['gender'];
        $membership_id = $_POST['membership_id'];
        $join_date = date('Y-m-d');
        
        $sql = "INSERT INTO Members (name, email, phone, gender, join_date, membership_id) 
                VALUES ('$name', '$email', '$phone', '$gender', '$join_date', $membership_id)";
        
        if ($conn->query($sql) === TRUE) {
            $success_message = "New member added successfully";
        } else {
            $error_message = "Error: " . $sql . "<br>" . $conn->error;
        }
    }
    
    // Add new trainer
    if (isset($_POST['add_trainer'])) {
        $name = $_POST['trainer_name'];
        $specialization = $_POST['specialization'];
        $phone = $_POST['trainer_phone'];
        
        $sql = "INSERT INTO Trainers (name, specialization, phone) 
                VALUES ('$name', '$specialization', '$phone')";
        
        if ($conn->query($sql) === TRUE) {
            $success_message = "New trainer added successfully";
        } else {
            $error_message = "Error: " . $sql . "<br>" . $conn->error;
        }
    }
    
    // Record attendance
    if (isset($_POST['record_attendance'])) {
        $member_id = $_POST['attendance_member_id'];
        $status = $_POST['status'];
        $date = date('Y-m-d');
        
        $sql = "INSERT INTO Attendance (member_id, date, status) 
                VALUES ($member_id, '$date', '$status')";
        
        if ($conn->query($sql) === TRUE) {
            $success_message = "Attendance recorded successfully";
        } else {
            $error_message = "Error: " . $sql . "<br>" . $conn->error;
        }
    }
    
    // Record payment
    if (isset($_POST['record_payment'])) {
        $member_id = $_POST['payment_member_id'];
        $membership_id = $_POST['payment_membership_id'];
        $amount = $_POST['amount'];
        $payment_date = date('Y-m-d');
        
        $sql = "INSERT INTO Payments (member_id, membership_id, amount, payment_date) 
                VALUES ($member_id, $membership_id, $amount, '$payment_date')";
        
        if ($conn->query($sql) === TRUE) {
            $success_message = "Payment recorded successfully";
        } else {
            $error_message = "Error: " . $sql . "<br>" . $conn->error;
        }
    }
    
    // Assign trainer to member
    if (isset($_POST['assign_trainer'])) {
        $member_id = $_POST['assign_member_id'];
        $trainer_id = $_POST['assign_trainer_id'];
        $assigned_date = date('Y-m-d');
        
        $sql = "INSERT INTO Member_Trainer (member_id, trainer_id, assigned_date) 
                VALUES ($member_id, $trainer_id, '$assigned_date')";
        
        if ($conn->query($sql) === TRUE) {
            $success_message = "Trainer assigned successfully";
        } else {
            $error_message = "Error: " . $sql . "<br>" . $conn->error;
        }
    }
}

// Get membership plans for dropdown
$membership_plans = $conn->query("SELECT * FROM membership_Plans");

// Get members for dropdown
$members = $conn->query("SELECT * FROM Members");

// Get trainers for dropdown
$trainers = $conn->query("SELECT * FROM Trainers");

// Get stats for dashboard
$total_members = $conn->query("SELECT COUNT(*) as count FROM Members")->fetch_assoc()['count'];
$total_trainers = $conn->query("SELECT COUNT(*) as count FROM Trainers")->fetch_assoc()['count'];
$total_payments = $conn->query("SELECT SUM(amount) as total FROM Payments")->fetch_assoc()['total'] ?: 0;
$today_attendance = $conn->query("SELECT COUNT(*) as count FROM Attendance WHERE date = CURDATE() AND status = 'Present'")->fetch_assoc()['count'];
